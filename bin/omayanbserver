#!/usr/bin/env python
import sys
from optparse import OptionParser
import omayanb
from omayanb.tcpip.omaynb_socket_server import OMAyANBSocketServer
from omayanb.logging import logger
import daemon
from daemon import pidfile

logger.name = __name__

def start_omaynb_server(options):
    omayanb_sock = OMAyANBSocketServer(HOST=options.hostname,
                                    PORT=options.portnumber
                                    )
    logger.info("OMAyANB Socket server started")
    logger.info("Waiting for socket connection from client")
    omayanb_sock.listen(10)
    while True:
        omayanb_sock.accept()
        while True:
            if omayanb_sock.process_omayanb_command():
                #print "Processed command"
                logger.info("Processed command")
                #print "Ctrl-C to quit"
                logger.info( "Ctrl-C to quit")
            else:
                omayanb_sock.conn_close()
                break
                                     
# def start_daemon(options):
#     print "Starting Daemon"
#     with daemon.DaemonContext(
#             pidfile=pidfile.TimeoutPIDLockFile(options.pidfile),
#     ) as context:
#         start_spectometer(options)



if __name__ == '__main__':
    usage = "usage: %prog [options]"
    parser = OptionParser(usage=usage)
    parser.add_option("-H", "--hostname", dest="hostname",
                      action="store", default="0.0.0.0",
                      help="Hostname for server (default %default)")
    parser.add_option("-p", "--port", dest="portnumber",
                      action="store", type="int",
                      default=9221,
                      help="Port for omayanb server to bind on (default %default)")
    (options, args) = parser.parse_args()
    start_omayanb_server(options)
    
